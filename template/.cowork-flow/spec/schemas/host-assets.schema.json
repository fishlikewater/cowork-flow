{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork-flow.local/schemas/host-assets.schema.json",
  "title": "cowork-flow Host Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityValues",
    "capabilityMatrix",
    "platforms",
    "excludedPrefixes",
    "syncPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capabilityValues": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "native"
        },
        {
          "const": "shim"
        },
        {
          "const": "plugin"
        },
        {
          "const": "external"
        },
        {
          "const": "experimental"
        },
        {
          "const": "unsupported"
        }
      ],
      "items": false
    },
    "capabilityMatrix": {
      "$ref": "#/$defs/capabilityMatrix"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "excludedPrefixes": {
      "$ref": "#/$defs/stringList"
    },
    "syncPolicy": {
      "$ref": "#/$defs/syncPolicy"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/capabilityStatus"
      }
    },
    "capabilityStatus": {
      "type": "string",
      "enum": [
        "native",
        "shim",
        "plugin",
        "external",
        "experimental",
        "unsupported"
      ]
    },
    "hostNeutralCapabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/capabilityStatus"
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsupported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "fallback"
            ]
          }
        }
      ]
    },
    "hostNeutralCapabilitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_action",
        "subagent_dispatch",
        "file_write",
        "party_board_action"
      ],
      "properties": {
        "task_action": {
          "$ref": "#/$defs/hostNeutralCapabilityDeclaration"
        },
        "subagent_dispatch": {
          "$ref": "#/$defs/hostNeutralCapabilityDeclaration"
        },
        "file_write": {
          "$ref": "#/$defs/hostNeutralCapabilityDeclaration"
        },
        "party_board_action": {
          "$ref": "#/$defs/hostNeutralCapabilityDeclaration"
        }
      }
    },
    "capabilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "hosts"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "task_action"
            },
            {
              "const": "subagent_dispatch"
            },
            {
              "const": "file_write"
            },
            {
              "const": "party_board_action"
            }
          ],
          "items": false
        },
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/hostNeutralCapabilitySet"
          }
        }
      }
    },
    "payload": {
      "description": "Machine-level plugin payload for this host, or null when the host ships no plugin payload. The payload lives at `source` inside the npm package; `manifest` is the plugin manifest path relative to that directory. Machine install locations (host home, registries) are installer concerns and are deliberately not declared here.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "manifest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "commandTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "format",
        "target"
      ],
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "toml",
            "yaml"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skillDiscoveryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "evidence",
        "path"
      ],
      "properties": {
        "scope": {
          "enum": [
            "project"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "aliases",
        "detectAny",
        "assetPrefixes",
        "assetFiles",
        "skillReadRoot",
        "skillDiscovery",
        "adapterPath",
        "capabilities",
        "commandTargets",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/aliasList"
        },
        "detectAny": {
          "$ref": "#/$defs/stringList"
        },
        "assetPrefixes": {
          "$ref": "#/$defs/stringList"
        },
        "assetFiles": {
          "$ref": "#/$defs/stringList"
        },
        "skillReadRoot": {
          "type": "string",
          "minLength": 1
        },
        "skillDiscovery": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skillDiscoveryEntry"
          }
        },
        "adapterPath": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "commandTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandTarget"
          }
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      }
    },
    "syncPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedFiles",
        "protectedPrefixes",
        "safeFiles",
        "safePrefixes",
        "managedBlockFiles",
        "obsoleteFiles"
      ],
      "properties": {
        "protectedFiles": {
          "$ref": "#/$defs/stringList"
        },
        "protectedPrefixes": {
          "$ref": "#/$defs/stringList"
        },
        "safeFiles": {
          "$ref": "#/$defs/stringList"
        },
        "safePrefixes": {
          "$ref": "#/$defs/stringList"
        },
        "managedBlockFiles": {
          "$ref": "#/$defs/stringList"
        },
        "obsoleteFiles": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "aliasList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
