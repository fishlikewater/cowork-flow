{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork-flow.local/schemas/host-assets.schema.json",
  "title": "cowork-flow Host Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityValues",
    "platforms",
    "excludedPrefixes",
    "syncPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capabilityValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "excludedPrefixes": {
      "$ref": "#/$defs/stringList"
    },
    "syncPolicy": {
      "$ref": "#/$defs/syncPolicy"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "commandTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "format",
        "target"
      ],
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "toml",
            "yaml"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "aliases",
        "detectAny",
        "assetPrefixes",
        "assetFiles",
        "skillTarget",
        "adapterPath",
        "capabilities",
        "commandTargets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "detectAny": {
          "$ref": "#/$defs/stringList"
        },
        "assetPrefixes": {
          "$ref": "#/$defs/stringList"
        },
        "assetFiles": {
          "$ref": "#/$defs/stringList"
        },
        "skillTarget": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapterPath": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "commandTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandTarget"
          }
        }
      }
    },
    "syncPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protectedFiles",
        "protectedPrefixes",
        "safeFiles",
        "safePrefixes",
        "managedBlockFiles",
        "obsoleteFiles"
      ],
      "properties": {
        "protectedFiles": {
          "$ref": "#/$defs/stringList"
        },
        "protectedPrefixes": {
          "$ref": "#/$defs/stringList"
        },
        "safeFiles": {
          "$ref": "#/$defs/stringList"
        },
        "safePrefixes": {
          "$ref": "#/$defs/stringList"
        },
        "managedBlockFiles": {
          "$ref": "#/$defs/stringList"
        },
        "obsoleteFiles": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
