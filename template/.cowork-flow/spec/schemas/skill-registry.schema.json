{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork-flow.dev/schemas/skill-registry.schema.json",
  "title": "cowork-flow Skill Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "aliases",
        "kind",
        "visibility",
        "status",
        "statuses",
        "intents",
        "enforcement",
        "runtimeGate",
        "runtimeCommand",
        "evidenceArtifact",
        "source",
        "managedPaths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "kind": {
          "enum": [
            "phase",
            "protocol",
            "domain",
            "mode",
            "runtime"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "status": {
          "enum": [
            "active",
            "deprecated",
            "disabled"
          ]
        },
        "statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "no_task",
              "planning",
              "in_progress",
              "review",
              "completed",
              "delegated_subtask"
            ]
          }
        },
        "intents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "enforcement": {
          "enum": [
            "advisory",
            "mandatory",
            "runtime"
          ]
        },
        "runtimeGate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "runtimeCommand": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidenceArtifact": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "managedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+/$"
          }
        },
        "readWhen": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "devTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pathPatterns": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "devTypes"
              ]
            },
            {
              "required": [
                "pathPatterns"
              ]
            }
          ]
        },
        "replacement": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "removeAfter": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcement": {
                "const": "mandatory"
              }
            }
          },
          "then": {
            "properties": {
              "runtimeGate": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            }
          },
          "then": {
            "required": [
              "replacement",
              "removeAfter"
            ],
            "properties": {
              "replacement": {
                "type": "string",
                "minLength": 1
              },
              "removeAfter": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      ]
    }
  }
}
