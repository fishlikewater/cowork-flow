{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork-flow.local/spec/adapter.schema.json",
  "title": "Cowork Flow Host Adapter",
  "type": "object",
  "required": ["schemaVersion", "host", "displayName", "capabilities", "dispatch", "contracts", "fallback"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "required": [
        "dispatchSubagent",
        "freshChildContext",
        "sendFollowup",
        "waitChild",
        "listChildren",
        "cancelChild",
        "stateInjection",
        "backgroundChild"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      },
      "properties": {
        "dispatchSubagent": { "$ref": "#/$defs/capability" },
        "freshChildContext": { "$ref": "#/$defs/capability" },
        "sendFollowup": { "$ref": "#/$defs/capability" },
        "waitChild": { "$ref": "#/$defs/capability" },
        "listChildren": { "$ref": "#/$defs/capability" },
        "cancelChild": { "$ref": "#/$defs/capability" },
        "stateInjection": { "$ref": "#/$defs/capability" },
        "backgroundChild": { "$ref": "#/$defs/capability" }
      }
    },
    "dispatch": {
      "type": "object",
      "required": ["primitive"],
      "additionalProperties": {
        "type": ["string", "boolean", "number"]
      },
      "properties": {
        "primitive": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["entry", "envelope", "ackRequired", "executeRequired", "leafExecutor"],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "const": "COWORK_ENTRY_CONTRACT_V1"
        },
        "envelope": {
          "type": "string",
          "const": "COWORK_DISPATCH_V1"
        },
        "delegation": {
          "type": "string",
          "const": "COWORK_DELEGATION_V1"
        },
        "ackRequired": {
          "type": "boolean",
          "const": true
        },
        "executeRequired": {
          "type": "boolean",
          "const": true
        },
        "leafExecutor": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["whenRequiredCapabilityMissing"],
      "additionalProperties": false,
      "properties": {
        "whenRequiredCapabilityMissing": {
          "type": "string",
          "enum": ["inline_or_manual", "fail_closed"]
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": ["native", "shim", "plugin", "external", "experimental", "unsupported"]
    }
  }
}
