#!/bin/sh
# cowork-flow run launcher (ZCode plugin edition)
# Runs commands using the plugin's bundled Python runtime.
set -u

MIN_PYTHON_LABEL="Python 3.8+"
VERSION_CHECK='import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)'
WORKFLOW_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd) || exit 1

# Plugin cache runtime (resolved relative to this script)
# Path: hooks/runtime/run -> hooks/runtime/scripts/run.py
RUNTIME_SCRIPTS="$WORKFLOW_DIR/scripts"

if [ ! -d "$RUNTIME_SCRIPTS" ]; then
  echo "Error: cowork-flow runtime not found. Expected at: $RUNTIME_SCRIPTS" >&2
  exit 127
fi

RUNNER_SCRIPT="$RUNTIME_SCRIPTS/run.py"
if [ ! -f "$RUNNER_SCRIPT" ]; then
  echo "Error: run.py not found in runtime: $RUNTIME_SCRIPTS" >&2
  exit 127
fi

candidate_is_valid() {
  command -v "$1" >/dev/null 2>&1 || return 1
  "$1" -c "$VERSION_CHECK" >/dev/null 2>&1
}

select_python() {
  if candidate_is_valid "python3"; then
    SELECTED_PYTHON=python3
    return 0
  fi
  if candidate_is_valid "python"; then
    SELECTED_PYTHON=python
    return 0
  fi
  if candidate_is_valid "py"; then
    SELECTED_PYTHON=py
    SELECTED_PYTHON_ARG=-3
    return 0
  fi
  echo "Error: $MIN_PYTHON_LABEL required but not found." >&2
  exit 127
}

select_python

if [ -n "$SELECTED_PYTHON_ARG" ]; then
  export PYTHONPATH="$RUNTIME_SCRIPTS${PYTHONPATH:+:$PYTHONPATH}"
  exec "$SELECTED_PYTHON" "$SELECTED_PYTHON_ARG" "$RUNNER_SCRIPT" "$@"
fi

export PYTHONPATH="$RUNTIME_SCRIPTS${PYTHONPATH:+:$PYTHONPATH}"
exec "$SELECTED_PYTHON" "$RUNNER_SCRIPT" "$@"
