{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Party Mode V2 Host-Neutral Actions",
  "type": "object",
  "required": ["schema_version", "discussion_id", "next_actions"],
  "properties": {
    "schema_version": { "const": 1 },
    "discussion_id": { "type": "string", "minLength": 1 },
    "next_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["action_id", "type"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "dispatch_child",
            "send_control_message",
            "wait_children",
            "list_children",
            "close_child",
            "report_to_user"
          ]
        },
        "agent_id": { "type": "string" },
        "agent_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agent_kind": { "type": "string" },
        "lens": { "type": "string" },
        "message_kind": { "type": "string" },
        "prompt_file": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "dispatch_child" } } },
          "then": {
            "required": [
              "action_id",
              "type",
              "agent_id",
              "agent_kind",
              "lens",
              "message_kind",
              "prompt_file"
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "send_control_message" } } },
          "then": {
            "required": [
              "action_id",
              "type",
              "agent_id",
              "agent_kind",
              "lens",
              "message_kind",
              "prompt_file"
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "wait_children" } } },
          "then": { "required": ["action_id", "type", "agent_ids"] }
        },
        {
          "if": { "properties": { "type": { "const": "list_children" } } },
          "then": { "required": ["action_id", "type"] }
        },
        {
          "if": { "properties": { "type": { "const": "close_child" } } },
          "then": { "required": ["action_id", "type", "agent_id", "reason"] }
        },
        {
          "if": { "properties": { "type": { "const": "report_to_user" } } },
          "then": { "required": ["action_id", "type", "reason"] }
        }
      ]
    }
  }
}
