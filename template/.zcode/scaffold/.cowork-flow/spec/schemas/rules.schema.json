{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork-flow.dev/schemas/rules.schema.json",
  "title": "Cowork Flow Rules Schema",
  "description": "Schema for machine-readable rule set extracted from workflow.md and AGENTS.md",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version number"
    },
    "rules": {
      "type": "array",
      "description": "Array of rules",
      "items": {
        "type": "object",
        "required": ["id", "type", "severity", "scope", "condition", "message", "fix_hint", "source_file", "enforcement"],
        "anyOf": [
          {"required": ["source_anchor"]},
          {"required": ["source_excerpt"]}
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-[A-Z]+-\\d{3}$",
            "description": "Unique rule identifier"
          },
          "type": {
            "type": "string",
            "enum": ["phase_gate", "forbidden_action"],
            "description": "Rule type: phase_gate for workflow constraints, forbidden_action for prohibited behaviors"
          },
          "severity": {
            "type": "string",
            "enum": ["block", "warn"],
            "description": "Severity level: block stops execution, warn only logs"
          },
          "scope": {
            "type": "string",
            "enum": ["task_start", "task_review", "task_complete", "check", "implement", "task_archive", "all"],
            "description": "Scope where rule applies"
          },
          "condition": {
            "type": "string",
            "description": "Human-readable condition for rule evaluation"
          },
          "message": {
            "type": "string",
            "description": "Error message when rule is violated"
          },
          "fix_hint": {
            "type": "string",
            "description": "Specific instruction for fixing the violation"
          },
          "source_file": {
            "type": "string",
            "description": "Original markdown file path"
          },
          "source_anchor": {
            "type": "string",
            "description": "Stable source section or anchor in the source file"
          },
          "source_excerpt": {
            "type": "string",
            "description": "Optional short excerpt from the source contract"
          },
          "enforcement": {
            "type": "string",
            "enum": ["validate_rules", "validate_implementation"],
            "description": "Runtime surface responsible for enforcing this rule. Must have a corresponding validator module."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "rules"],
  "additionalProperties": false
}
