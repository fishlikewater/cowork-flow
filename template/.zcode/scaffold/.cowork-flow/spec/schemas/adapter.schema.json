{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowork-flow.local/spec/adapter.schema.json",
  "title": "Cowork Flow Host Adapter",
  "type": "object",
  "required": ["schemaVersion", "host", "displayName", "capabilities", "dispatch", "runtimeContext", "contracts", "fallback"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "required": [
        "dispatchSubagent",
        "freshChildContext",
        "sendFollowup",
        "waitChild",
        "listChildren",
        "cancelChild",
        "stateInjection",
        "backgroundChild",
        "runtimeContextDispatch",
        "runtimeContextBinding",
        "runtimeContextCleanup"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      },
      "properties": {
        "dispatchSubagent": { "$ref": "#/$defs/capability" },
        "freshChildContext": { "$ref": "#/$defs/capability" },
        "sendFollowup": { "$ref": "#/$defs/capability" },
        "waitChild": { "$ref": "#/$defs/capability" },
        "listChildren": { "$ref": "#/$defs/capability" },
        "cancelChild": { "$ref": "#/$defs/capability" },
        "stateInjection": { "$ref": "#/$defs/capability" },
        "backgroundChild": { "$ref": "#/$defs/capability" },
        "runtimeContextDispatch": { "$ref": "#/$defs/capability" },
        "runtimeContextBinding": { "$ref": "#/$defs/capability" },
        "runtimeContextCleanup": { "$ref": "#/$defs/capability" }
      }
    },
    "dispatch": {
      "type": "object",
      "required": ["primitive"],
      "additionalProperties": {
        "type": ["string", "boolean", "number"]
      },
      "properties": {
        "primitive": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeContext": {
      "type": "object",
      "required": ["transport", "promptKey", "envKey", "metadataKey"],
      "additionalProperties": {
        "type": ["string", "boolean", "number"]
      },
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["prompt", "env", "metadata", "plugin"]
        },
        "promptKey": {
          "type": "string",
          "const": "cowork_runtime_context_id"
        },
        "envKey": {
          "type": "string",
          "const": "COWORK_FLOW_RUNTIME_CONTEXT_ID"
        },
        "metadataKey": {
          "type": "string",
          "const": "cowork_runtime_context_id"
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["dispatch", "leafExecutor"],
      "additionalProperties": false,
      "properties": {
        "dispatch": {
          "type": "string",
          "const": "RUNTIME_CONTEXT_DISPATCH_V2"
        },
        "leafExecutor": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["whenRequiredCapabilityMissing"],
      "additionalProperties": false,
      "properties": {
        "whenRequiredCapabilityMissing": {
          "type": "string",
          "enum": ["inline_or_manual", "fail_closed"]
        },
        "whenRuntimeContextMissing": {
          "type": "string",
          "enum": ["fail_closed"]
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": ["native", "shim", "plugin", "external", "experimental", "unsupported"]
    }
  }
}
