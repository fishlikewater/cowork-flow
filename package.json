{
  "name": "cowork-flow",
  "version": "0.0.30",
  "description": "CLI for installing and maintaining cowork-flow collaboration templates.",
  "type": "module",
  "bin": {
    "cowork-flow": "./bin/cowork-flow.js"
  },
  "files": [
    "bin",
    "src",
    "template",
    "template/.zcode",
    "README.md",
    "!template/**/__pycache__/**",
    "!template/**/*.pyc"
  ],
  "scripts": {
    "test": "node --test",
    "test:template": "node scripts/run-template-tests.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "pack:check": "node scripts/pack-check.js",
    "test:all": "npm test && npm run test:template && npm run pack:check",
    "release": "sh scripts/release.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
