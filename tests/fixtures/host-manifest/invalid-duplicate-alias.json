{
  "schemaVersion": 1,
  "capabilityValues": [
    "native",
    "shim",
    "plugin",
    "external",
    "experimental",
    "unsupported"
  ],
  "capabilityMatrix": {
    "required": [
      "task_action",
      "subagent_dispatch",
      "file_write",
      "party_board_action"
    ],
    "hosts": {
      "codex": {
        "task_action": {
          "status": "native"
        },
        "subagent_dispatch": {
          "status": "native"
        },
        "file_write": {
          "status": "native"
        },
        "party_board_action": {
          "status": "native"
        }
      },
      "claude-code": {
        "task_action": {
          "status": "external"
        },
        "subagent_dispatch": {
          "status": "external"
        },
        "file_write": {
          "status": "native"
        },
        "party_board_action": {
          "status": "unsupported",
          "fallback": "inline_or_manual"
        }
      },
      "opencode": {
        "task_action": {
          "status": "external"
        },
        "subagent_dispatch": {
          "status": "external"
        },
        "file_write": {
          "status": "native"
        },
        "party_board_action": {
          "status": "unsupported",
          "fallback": "inline_or_manual"
        }
      },
      "zcode": {
        "task_action": {
          "status": "external"
        },
        "subagent_dispatch": {
          "status": "unsupported",
          "fallback": "inline_or_manual"
        },
        "file_write": {
          "status": "unsupported",
          "fallback": "project_root_init_or_sync"
        },
        "party_board_action": {
          "status": "unsupported",
          "fallback": "inline_or_manual"
        }
      },
      "demo-host": {
        "task_action": {
          "status": "external"
        },
        "subagent_dispatch": {
          "status": "unsupported",
          "fallback": "inline_or_manual"
        },
        "file_write": {
          "status": "native"
        },
        "party_board_action": {
          "status": "experimental"
        }
      }
    }
  },
  "platforms": [
    {
      "id": "codex",
      "displayName": "Codex",
      "aliases": [
        "codex"
      ],
      "detectAny": [
        ".codex"
      ],
      "assetPrefixes": [
        ".codex/"
      ],
      "assetFiles": [],
      "skillTarget": ".agents/skills",
      "adapterPath": ".cowork-flow/adapters/codex/adapter.yaml",
      "capabilities": {
        "dispatchSubagent": "native"
      },
      "commandTargets": [
        {
          "config": ".codex/config.toml",
          "format": "toml",
          "target": ".codex/agents/cowork-implement.toml"
        }
      ]
    },
    {
      "id": "demo-host",
      "displayName": "Demo Host",
      "aliases": [
        "codex",
        "demo-host"
      ],
      "detectAny": [
        ".demo-host"
      ],
      "assetPrefixes": [
        ".demo-host/"
      ],
      "assetFiles": [
        "AGENTS.md"
      ],
      "skillTarget": ".demo-host/skills",
      "adapterPath": ".cowork-flow/adapters/demo-host/adapter.yaml",
      "capabilities": {
        "dispatchSubagent": "external"
      },
      "commandTargets": [
        {
          "config": ".demo-host/config.json",
          "format": "json",
          "target": ".demo-host/agents/cowork-implement.md"
        }
      ]
    }
  ],
  "excludedPrefixes": [
    "skills/"
  ],
  "syncPolicy": {
    "protectedFiles": [
      ".cowork-flow/config.yaml"
    ],
    "protectedPrefixes": [
      ".cowork-flow/.runtime/"
    ],
    "safeFiles": [
      ".codex/config.toml"
    ],
    "safePrefixes": [
      ".codex/"
    ],
    "managedBlockFiles": [
      "AGENTS.md"
    ],
    "obsoleteFiles": [
      ".cowork-flow/workflow.md"
    ]
  }
}
