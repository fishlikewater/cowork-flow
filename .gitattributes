* text=auto

# Shell scripts — always LF
*.sh text eol=lf
# A pattern containing "/" is anchored to this file's directory, so the runner
# shipped in template/ needs its own line: `.cowork-flow/run` alone only ever
# matched the gitignored self-instance copy, and a CRLF checkout of the
# template copy is what init writes into projects.
.cowork-flow/run text eol=lf
template/.cowork-flow/run text eol=lf

# Batch files — always CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Python
*.py text eol=lf

# JavaScript / ESM — always LF; a CRLF checkout breaks shebang-based shims
*.js text eol=lf
*.mjs text eol=lf

# Version marker — release byte-compares it, keep LF everywhere
*.version text eol=lf

# Brand mark — the payload copy is byte-compared against the source, and the
# source is fetched over https by the zcode marketplace entry
*.svg text eol=lf

# Config
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Lockfiles — diff off
package-lock.json -diff
