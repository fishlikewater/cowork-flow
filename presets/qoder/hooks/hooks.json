{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/inject-context.mjs"
            ],
            "timeout": 30,
            "statusMessage": "cowork-flow: 注入工作流状态"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/hooks/inject-context.mjs"
            ],
            "timeout": 30,
            "statusMessage": "cowork-flow: 注入工作流状态"
          }
        ]
      }
    ]
  }
}
