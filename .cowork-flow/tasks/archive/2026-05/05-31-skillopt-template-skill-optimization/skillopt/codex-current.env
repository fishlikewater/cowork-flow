# Source this file from a shell before running SkillOpt:
#
#   source .cowork-flow/tasks/archive/2026-05/05-31-skillopt-template-skill-optimization/skillopt/codex-current.env
#
# It derives SkillOpt model credentials from the current Codex config without
# writing the API key into this file.

_codex_skillopt_python="${CODEX_SKILLOPT_PYTHON:-/Users/zhangx/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3}"
_codex_skillopt_exports="$("$_codex_skillopt_python" - <<'PY'
from pathlib import Path
import json
import shlex
import tomllib

config_path = Path.home() / ".codex" / "config.toml"
auth_path = Path.home() / ".codex" / "auth.json"

config = tomllib.loads(config_path.read_text(encoding="utf-8"))
auth = json.loads(auth_path.read_text(encoding="utf-8"))
provider_name = str(config.get("model_provider") or "")
provider = (config.get("model_providers") or {}).get(provider_name, {})

endpoint = str(provider.get("base_url") or "https://api.openai.com/v1")
api_key = str(auth.get("OPENAI_API_KEY") or "")
model = str(config.get("model") or "gpt-5.5")
reasoning = str(config.get("model_reasoning_effort") or config.get("reasoning_effort") or "")

if not api_key:
    raise SystemExit("~/.codex/auth.json does not contain OPENAI_API_KEY")

exports = {
    "AZURE_OPENAI_ENDPOINT": endpoint,
    "AZURE_OPENAI_AUTH_MODE": "openai_compatible",
    "AZURE_OPENAI_API_KEY": api_key,
    "OPTIMIZER_AZURE_OPENAI_ENDPOINT": endpoint,
    "OPTIMIZER_AZURE_OPENAI_AUTH_MODE": "openai_compatible",
    "OPTIMIZER_AZURE_OPENAI_API_KEY": api_key,
    "TARGET_AZURE_OPENAI_ENDPOINT": endpoint,
    "TARGET_AZURE_OPENAI_AUTH_MODE": "openai_compatible",
    "TARGET_AZURE_OPENAI_API_KEY": api_key,
    "OPTIMIZER_DEPLOYMENT": model,
    "TARGET_DEPLOYMENT": model,
    "OPTIMIZER_BACKEND": "openai_chat",
    "TARGET_BACKEND": "openai_chat",
}
if reasoning:
    exports["SKILLOPT_REASONING_EFFORT"] = reasoning

for key, value in exports.items():
    print(f"export {key}={shlex.quote(value)}")
PY
)"
eval "$_codex_skillopt_exports"
unset _codex_skillopt_python _codex_skillopt_exports
