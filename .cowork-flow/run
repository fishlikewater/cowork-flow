#!/bin/sh
set -u

MIN_PYTHON_LABEL="Python 3.8+"
VERSION_CHECK='import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)'

WORKFLOW_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd) || exit 1
SCRIPTS_DIR="$WORKFLOW_DIR/scripts"

print_usage() {
  cat <<'EOF'
用法：
  ./.cowork-flow/run <command> [args...]
  ./.cowork-flow/run python [python-args...]

常用 command：
  resume
  task
  change
  get-context
  get-developer
  init-developer
  add-session

解释器选择顺序：
  COWORK_FLOW_PYTHON -> PYTHON -> python3 -> python -> py -3
EOF
}

candidate_is_valid() {
  candidate_cmd=$1
  candidate_arg=${2:-}

  command -v "$candidate_cmd" >/dev/null 2>&1 || return 1

  if [ -n "$candidate_arg" ]; then
    "$candidate_cmd" "$candidate_arg" -c "$VERSION_CHECK" >/dev/null 2>&1
  else
    "$candidate_cmd" -c "$VERSION_CHECK" >/dev/null 2>&1
  fi
}

select_explicit_python() {
  env_name=$1
  env_value=$2

  if candidate_is_valid "$env_value"; then
    SELECTED_PYTHON=$env_value
    SELECTED_PYTHON_ARG=
    return 0
  fi

  echo "错误：$env_name 指向的解释器不可用或版本低于 ${MIN_PYTHON_LABEL}：$env_value" >&2
  echo "请设置 $env_name 为可执行的 Python 3.8+ 解释器路径。" >&2
  exit 127
}

select_python() {
  SELECTED_PYTHON=
  SELECTED_PYTHON_ARG=

  if [ -n "${COWORK_FLOW_PYTHON:-}" ]; then
    select_explicit_python "COWORK_FLOW_PYTHON" "$COWORK_FLOW_PYTHON"
    return 0
  fi

  if [ -n "${PYTHON:-}" ]; then
    select_explicit_python "PYTHON" "$PYTHON"
    return 0
  fi

  if candidate_is_valid "python3"; then
    SELECTED_PYTHON=python3
    return 0
  fi

  if candidate_is_valid "python"; then
    SELECTED_PYTHON=python
    return 0
  fi

  if candidate_is_valid "py" "-3"; then
    SELECTED_PYTHON=py
    SELECTED_PYTHON_ARG=-3
    return 0
  fi

  echo "错误：需要 ${MIN_PYTHON_LABEL}，但未找到可用解释器。" >&2
  echo "已尝试：COWORK_FLOW_PYTHON、PYTHON、python3、python、py -3。" >&2
  echo "可设置 COWORK_FLOW_PYTHON=/path/to/python3 后重试。" >&2
  exit 127
}

exec_python() {
  select_python

  if [ -n "$SELECTED_PYTHON_ARG" ]; then
    exec "$SELECTED_PYTHON" "$SELECTED_PYTHON_ARG" "$@"
  fi

  exec "$SELECTED_PYTHON" "$@"
}

run_script() {
  script_path=$1
  shift

  if [ ! -f "$script_path" ]; then
    echo "错误：找不到脚本：$script_path" >&2
    exit 2
  fi

  exec_python "$script_path" "$@"
}

if [ "$#" -eq 0 ]; then
  print_usage >&2
  exit 2
fi

command_name=$1
shift

case "$command_name" in
  -h|--help|help)
    print_usage
    exit 0
    ;;
  python)
    exec_python "$@"
    ;;
  resume)
    run_script "$SCRIPTS_DIR/resume.py" "$@"
    ;;
  task)
    run_script "$SCRIPTS_DIR/task.py" "$@"
    ;;
  change)
    run_script "$SCRIPTS_DIR/change.py" "$@"
    ;;
  get-context|get_context)
    run_script "$SCRIPTS_DIR/get_context.py" "$@"
    ;;
  get-developer|get_developer)
    run_script "$SCRIPTS_DIR/get_developer.py" "$@"
    ;;
  init-developer|init_developer)
    run_script "$SCRIPTS_DIR/init_developer.py" "$@"
    ;;
  add-session|add_session)
    run_script "$SCRIPTS_DIR/add_session.py" "$@"
    ;;
  *)
    if [ -f "$SCRIPTS_DIR/$command_name.py" ]; then
      run_script "$SCRIPTS_DIR/$command_name.py" "$@"
    fi

    echo "错误：未知 cowork-flow 命令：$command_name" >&2
    print_usage >&2
    exit 2
    ;;
esac
